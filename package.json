{
  "name": "baznas-data-center-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run start",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "test": "npm --prefix frontend run test",
    "test:server": "node --test --test-concurrency=1 server/*.test.js",
    "p0:migration:dry-run": "node server/penyaluran-p0/migration-runner.js --dry-run",
    "p0:migration:run": "node server/penyaluran-p0/migration-runner.js --apply",
    "mustahik:normalize:test-db": "node server/run-mustahik-normalization.js --apply",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^1.2.0",
    "ollama": "^0.6.3",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "oxlint": "^1.71.0",
    "pg-mem": "^3.0.14"
  }
}
