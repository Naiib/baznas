PORT=3001
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=kimi-k2.6
# Production startup rejects this example JWT secret; set a unique secret through the environment.
JWT_SECRET=change-me-in-production
# Set this to the deployed frontend URL in production.
FRONTEND_URL=https://muhammadrofiq.my.id
UPLOAD_DIR=./uploads
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=baznas_db
DB_USER=baznas_user
DB_PASSWORD=BaznasTangerang2026!
DATABASE_URL=postgresql://baznas_user:BaznasTangerang2026!@127.0.0.1:5432/baznas_db

# Penyaluran P0 Feature Flags & Cutover Gate
PENYALURAN_P0_ENABLED=false
PENYALURAN_P0_CUTOVER_AT=
PENYALURAN_FIELD_ENCRYPTION_KEY=
PENYALURAN_ARTIFACT_DIR=./private-artifacts

# Penerimaan Webhook Provider Secret Encryption Key (AES-256-GCM)
# Required in deployed environments. 32-byte key formatted as 64 hex characters or base64 string.
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PENERIMAAN_PROVIDER_SECRET_ENCRYPTION_KEY=generate_64_hex_chars_or_base64_encryption_key_here
PENERIMAAN_EXPORT_DIR=./exports
